# Local dev defaults — copy to .env (never commit .env)

ENV=development
# Production: ENV=production  (hides stack traces, requires JWT_SECRET)

ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TIKTOK_SELLER=
STRIPE_PRICE_TIKTOK_SELLER_YEARLY=

JWT_SECRET=change-me-long-random-string

# Persistent local DB (default: backend/data/platform.db — not in the Chrome extension)
# DB_PATH=C:/path/to/your/platform.db

# TODO: Migrate to PostgreSQL before 1000+ users.
# Postgres (Neon): `neon link` writes DATABASE_URL to .env — app uses it when set.
# Local-only SQLite: leave DATABASE_URL unset (optional DB_PATH override).
# DATABASE_URL=postgresql://...

# Your separate telemetry dashboard app uses this to read events:
TELEMETRY_ADMIN_KEY=change-me-admin-read-key

# Checkout success/cancel landing (extension users can use any HTTPS page)
FRONTEND_URL=https://mail.google.com

# TODO: Enforce HTTPS in production (platform TLS). localhost HTTP is OK for dev.

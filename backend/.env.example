# Copy to backend/.env (never commit .env). Placeholders only.
# Local values stay in this file. LLE values go in Fly secrets for marginmark-api-lle.
# Prod values go in Fly secrets for marginmark-api-prod. Do not reuse values across those three.

# development locally. Fly toml sets production.
ENV=development
# local here. Fly toml sets lle or prod. dev-up.ps1 refuses anything except local.
APP_ENV=local

# Where this API is reached. No trailing slash.
# Local: http://127.0.0.1:8000
# LLE Fly secret is not needed; fly.lle.toml sets PUBLIC_BASE_URL.
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=https://plainsmansoftware.com

# Neon pooled connection string, one line, host contains -pooler.
# Local project: marginmark-dev. Do not paste the LLE or prod URL here.
# Console: Neon → marginmark-dev → Connect → Pooled connection.
DATABASE_URL=
# Optional hostname guard. If set, startup refuses when DATABASE_URL's host differs.
EXPECTED_DB_HOST=
# Optional. If set, APP_ENV=local refuses to boot when DATABASE_URL uses that host.
EXPECTED_DB_HOST_LLE=
EXPECTED_DB_HOST_PROD=

# Generate each with: python -c "import secrets; print(secrets.token_hex(32))"
# Three different values. At least 32 bytes. Do not reuse them on LLE or prod.
JWT_SECRET=
ADMIN_KEY=
TELEMETRY_READ_KEY=

# Comma-separated IPs allowed to open /ops. Local can stay empty.
# Your current IP: curl.exe -s https://api.ipify.org
ADMIN_IP_ALLOWLIST=
ADMIN_DB_WRITE=0

# Chrome extension ids (32 lowercase letters), comma-separated. CORS and OAuth allowlist.
EXTENSION_IDS=

# Stripe Dashboard → Developers → API keys. Local and LLE use sk_test_. Prod uses sk_live_.
STRIPE_SECRET_KEY=
# Stripe CLI `stripe listen` prints this locally. LLE uses the Workbench webhook signing secret.
STRIPE_WEBHOOK_SECRET=
# Set to 1 on LLE/prod after the endpoint lists all six events:
# checkout.session.completed, customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid, invoice.payment_failed
STRIPE_WEBHOOK_EVENTS_CONFIRMED=

# Stripe → Product catalog → Prices. Use the price_ id, not the amount.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_DIAMOND_MONTHLY=
STRIPE_PRICE_DIAMOND_YEARLY=
# Older names still accepted for the two Pro prices if the PRO_ names above are empty.
STRIPE_PRICE_TIKTOK_SELLER=
STRIPE_PRICE_TIKTOK_SELLER_YEARLY=

# Google Cloud Console → Credentials → OAuth client (Web).
# Redirect URI: {PUBLIC_BASE_URL}/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional providers. Leave empty until you enable them.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Optional. Command Center and insights stay off when unset.
ADMIN_API_ENABLED=0
ADMIN_API_TOKEN=
ADMIN_API_ALLOWLIST=
CONFIG_PUBLIC_KEY=
AI_DAILY_BUDGET_USD=5
ANTHROPIC_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=marginmark-api-local

# Every in-app note is emailed here. Subject starts with [problem], [support], [help], or [info].
# Squarespace aliases (support@, help@, info@) can all forward to this same mailbox.
SUPPORT_INBOX=
# SMTP for that mailbox. Google Workspace: smtp.gmail.com, port 587, and an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

#!/bin/sh
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$root" || exit 1
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/check-secrets.ps1"
fi
if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/check-secrets.ps1"
fi
echo "PowerShell is required for scripts/check-secrets.ps1" >&2
exit 1